<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat Setoran"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB FILTER -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSemua"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Semua"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/ic_bg_tab_active" />

            <TextView
                android:id="@+id/tabMingguIni"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Minggu Ini"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <TextView
                android:id="@+id/tabBulanIni"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bulan Ini"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <!-- ✅ TAB BARU -->
            <TextView
                android:id="@+id/tabSetoran"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Setoran"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <TextView
                android:id="@+id/tabPenarikan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Penarikan"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <TextView
                android:id="@+id/tabReward"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Reward"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- DAFTAR RIWAYAT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutDaftarRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />

    </ScrollView>
</LinearLayout>