<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:layout_marginTop="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ROW UTAMA — selalu tampil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <!-- Foto lokasi (jika ada) -->
            <ImageView
                android:id="@+id/ivFotoLokasi"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Nama + Tipe -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvNamaUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Unit Bisnis"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvTipeUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UB Kelurahan"
                    android:textSize="11sp"
                    android:textColor="@color/orange_primary"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Panah -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:alpha="0.3" />

        </LinearLayout>

        <!-- DETAIL — hanya tampil saat expand -->
        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Alamat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Alamat"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvAlamat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

            </LinearLayout>

            <!-- Jam Buka -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Jam Buka"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvJamOperasional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

            </LinearLayout>

            <!-- Hari Operasional -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Hari"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvHariOperasional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

            </LinearLayout>

            <!-- Koordinat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Koordinat"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvKoordinat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular" />

            </LinearLayout>

            <!-- Tombol Buka Maps -->
            <Button
                android:id="@+id/btnBukaMaps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Buka di Google Maps"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_semibold"
                android:backgroundTint="@color/orange_primary"
                android:visibility="gone"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>