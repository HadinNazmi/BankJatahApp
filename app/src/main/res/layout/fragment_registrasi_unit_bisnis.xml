<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_back"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendaftaran Kemitraan"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BANNER HERO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E1B4B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_nav_setor"
                        android:background="@drawable/ic_bg_aktivitas_orange"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:layout_gravity="center_horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Halo, Calon Mitra!"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ambang pintu kemitraan Bank Jatah telah terbuka. Dengan menjadi Unit Bisnis, Anda akan menjadi perpanjangan tangan kami dalam mengumpulkan dan me-manage sampah yang bisa didaur ulang di kawasan Anda."
                        android:textSize="12sp"
                        android:textColor="#CCFFFFFF"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#2D2B5F">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✦ Keuntungan Mitra"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/orange_primary"
                                android:fontFamily="@font/poppins_semibold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• Komisi ekstra dari setiap kg setoran nasabah di bawah naungan Unit Anda."
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• Akses ke dashboard khusus untuk monitoring dan validasi setoran skala besar."
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• Dukungan logistik penjemputan dari pusat."
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== CARD FORMULIR ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Formulir Registrasi"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lengkapi detail informasi calon unit bisnis Anda"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Nama Usaha -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Usaha / Nama Outlet"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNamaUsaha"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="20dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/orange_primary"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNamaUsaha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contoh: Outlet Suka Maju"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/black"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Divider section wilayah -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wilayah Operasional Utama"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginBottom="14dp" />

                    <!-- Provinsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Provinsi"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/background">

                        <Spinner
                            android:id="@+id/spinnerProvinsi"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </androidx.cardview.widget.CardView>

                    <!-- Kabupaten -->
                    <LinearLayout
                        android:id="@+id/layoutKabupaten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kabupaten / Kota"
                            android:textSize="12sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/background">

                            <Spinner
                                android:id="@+id/spinnerKabupaten"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Kecamatan -->
                    <LinearLayout
                        android:id="@+id/layoutKecamatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kecamatan"
                            android:textSize="12sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/background">

                            <Spinner
                                android:id="@+id/spinnerKecamatan"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Wilayah / Kelurahan -->
                    <LinearLayout
                        android:id="@+id/layoutWilayah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wilayah / Kelurahan"
                            android:textSize="12sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/background">

                            <Spinner
                                android:id="@+id/spinnerWilayah"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Loading harga -->
                    <TextView
                        android:id="@+id/tvHargaLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memuat harga wilayah..."
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- Card Harga Wilayah -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardHargaWilayah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/orange_primary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 Harga Minyak di Wilayah Ini"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/tvHargaPerKg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 0 / Kg"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_bold"
                                android:layout_marginTop="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kelurahan/Wilayah"
                                        android:textSize="11sp"
                                        android:textColor="#CCFFFFFF"
                                        android:fontFamily="@font/poppins_regular" />
                                    <TextView
                                        android:id="@+id/tvWilayahHarga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="-"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/poppins_semibold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kecamatan"
                                        android:textSize="11sp"
                                        android:textColor="#CCFFFFFF"
                                        android:fontFamily="@font/poppins_regular" />
                                    <TextView
                                        android:id="@+id/tvKecamatanHarga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="-"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/poppins_semibold" />
                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Harga ini yang akan berlaku untuk setoran minyak jelantah di wilayah Anda."
                                android:textSize="11sp"
                                android:textColor="#CCFFFFFF"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Info WhatsApp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#FFF3E0"
                        android:padding="12dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:scaleType="centerInside" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jika wilayah Anda tidak ada dalam daftar, "
                            android:textSize="11sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/tvHubungiWa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="hubungi WhatsApp"
                            android:textSize="11sp"
                            android:textColor="#25D366"
                            android:fontFamily="@font/poppins_semibold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Divider section alamat -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginBottom="16dp" />

                    <!-- Alamat -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alamat Lengkap Unit Bisnis"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAlamat"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/orange_primary"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAlamat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Masukkan alamat selengkap mungkin"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/black"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:maxLines="4"
                            android:gravity="top" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== CARD KOORDINAT PETA ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            android:background="@drawable/ic_bg_aktivitas_orange"
                            android:padding="6dp"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Koordinat Lokasi di Peta"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap peta atau gunakan lokasi GPS"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />

                        </LinearLayout>

                    </LinearLayout>

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tvKoordinatDipilih"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap peta untuk memilih lokasi"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:layout_marginTop="10dp" />

                    <Button
                        android:id="@+id/btnGunakanLokasiSaya"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="📍 Gunakan Lokasi Saya Sekarang"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_semibold"
                        android:backgroundTint="@color/orange_primary"
                        android:layout_marginTop="12dp"
                        app:cornerRadius="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeColor="@color/gray_border"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/etLatitude"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Latitude"
                                android:textSize="12sp"
                                android:focusable="false"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_regular" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeColor="@color/gray_border"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/etLongitude"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Longitude"
                                android:textSize="12sp"
                                android:focusable="false"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_regular" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== CARD BUKTI PEMBAYARAN ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@drawable/ic_bg_aktivitas_orange"
                            android:padding="6dp"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bukti Pembayaran Pendaftaran"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Upload foto bukti transfer/pembayaran"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Area preview / upload foto -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@color/background">

                        <ImageView
                            android:id="@+id/ivPreviewBuktiBayar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@android:drawable/ic_menu_gallery"
                                android:alpha="0.3" />

                            <TextView
                                android:id="@+id/tvBuktiBayarStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Belum ada foto yang dipilih"
                                android:textSize="12sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </FrameLayout>

                    <Button
                        android:id="@+id/btnPilihBuktiBayar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="📷 Pilih Foto Bukti Pembayaran"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_semibold"
                        android:backgroundTint="@color/orange_primary"
                        android:layout_marginTop="12dp"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOMBOL AJUKAN -->
            <Button
                android:id="@+id/btnAjukanKemitraan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ajukan Kemitraan"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_semibold"
                android:backgroundTint="@color/black"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabWhatsapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_menu_call"
        app:backgroundTint="#25D366"
        app:tint="@color/white"
        app:elevation="8dp" />

</FrameLayout>