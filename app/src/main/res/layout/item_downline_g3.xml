<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFF1E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Dot penanda -->
        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/ic_bg_menu_aksi_orange"
            android:layout_marginEnd="6dp" />

        <!-- Inisial mini -->
        <LinearLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ic_bg_tab_inactive"
            android:gravity="center">

            <TextView
                android:id="@+id/tvInisialG3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/orange_primary"
                android:fontFamily="@font/poppins_bold" />

        </LinearLayout>

        <!-- Nama + info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNamaG3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" G3"
                    android:textSize="9sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginStart="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvInfoG3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B1 • Pasif"
                android:textSize="9sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular" />

        </LinearLayout>

        <!-- Setoran G3 -->
        <TextView
            android:id="@+id/tvSetoranG3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Kg"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/orange_primary"
            android:fontFamily="@font/poppins_bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>