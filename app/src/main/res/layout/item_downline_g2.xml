<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="2dp">

    <!-- Garis konektor kiri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Garis vertikal + horizontal connector -->
        <LinearLayout
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <View
                android:layout_width="2dp"
                android:layout_height="18dp"
                android:background="#FFCC80" />

            <View
                android:layout_width="8dp"
                android:layout_height="2dp"
                android:background="#FFCC80"
                android:layout_gravity="end" />

        </LinearLayout>

        <!-- Card G2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFF8F3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar G2 -->
                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/ic_bg_tab_inactive"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvInisialG2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvNamaG2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nama"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" G2"
                                android:textSize="9sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_bold"
                                android:layout_marginStart="3dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInfoG2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B1 • Pasif"
                            android:textSize="10sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSetoranG2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Kg"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold" />

                </LinearLayout>

                <!-- Container G3 -->
                <LinearLayout
                    android:id="@+id/containerG3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</LinearLayout>