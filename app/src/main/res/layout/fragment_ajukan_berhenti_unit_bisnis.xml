<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== HEADER / TOOLBAR ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="8dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ajukan Berhenti"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== PROGRESS BAR ===== -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- ===== LAYOUT STATUS AKTIF (tampil jika sudah ada pengajuan) ===== -->
        <LinearLayout
            android:id="@+id/layoutStatusAktif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengajuan Aktif"
                        android:textSize="13sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvStatusPengajuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menunggu Diproses"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvTipePengajuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvTglPengajuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diajukan: -"
                        android:textSize="13sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvAlasanPengajuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alasan: -"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvCatatanAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pengajuan Anda sedang ditinjau oleh admin. Anda akan menerima notifikasi ketika ada pembaruan."
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ===== LAYOUT FORM ===== -->
        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:padding="20dp">

            <!-- Info card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yang perlu Anda ketahui"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Admin akan memverifikasi tidak ada transaksi aktif\n• Semua saldo relevan akan dicairkan sebelum penutupan\n• Proses dapat memakan waktu 1-5 hari kerja\n• Anda tidak dapat membuat pengajuan baru selama proses berlangsung"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card pilih tipe -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Pengajuan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih tipe penutupan yang sesuai"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Radio: Berhenti sebagai Unit Bisnis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <RadioButton
                            android:id="@+id/radioUnitBisnis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/orange_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Berhenti sebagai Unit Bisnis"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Akun nasabah tetap aktif"
                                android:textSize="12sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />

                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginStart="36dp" />

                    <!-- Radio: Berhenti Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <RadioButton
                            android:id="@+id/radioTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red_gagal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Berhenti Total dari Platform"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/red_gagal"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Semua akun dan saldo ditutup"
                                android:textSize="12sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Deskripsi dinamis sesuai pilihan -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvDeskripsiTipe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card alasan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alasan Berhenti"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opsional — bantu kami memahami alasan Anda"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etAlasan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tulis alasan Anda di sini..."
                        android:minLines="4"
                        android:maxLines="8"
                        android:gravity="top|start"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:background="@color/gray_border"
                        android:padding="12dp"
                        android:inputType="textMultiLine|textCapSentences" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Kirim -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKirimPengajuan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Kirim Pengajuan Berhenti"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_bold"
                app:backgroundTint="@color/red_gagal"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>