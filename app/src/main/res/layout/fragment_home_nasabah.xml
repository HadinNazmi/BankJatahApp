<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER ATAS MELENGKUNG SEPERTI AIR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Background Header Oranye Melengkung -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_header_curved" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- TOP BAR HEADER -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">

                        <!-- Logo Bank Jatah Warna Putih Bersih -->
                        <ImageView
                            android:id="@+id/ivLogoHeader"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/bankjatahlogo"
                            app:tint="@color/white"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Selamat datang kembali,"
                            android:textSize="11sp"
                            android:textColor="#E0FFFFFF"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toEndOf="@+id/ivLogoHeader"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/layoutKananHeader" />

                        <TextView
                            android:id="@+id/tvNamaUser"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Nama Nasabah"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginStart="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            app:layout_constraintStart_toEndOf="@+id/ivLogoHeader"
                            app:layout_constraintTop_toBottomOf="@+id/tvGreeting"
                            app:layout_constraintEnd_toStartOf="@+id/layoutKananHeader" />

                        <TextView
                            android:id="@+id/tvRoleUser"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Nasabah"
                            android:textSize="10sp"
                            android:textColor="#CCFFFFFF"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toEndOf="@+id/ivLogoHeader"
                            app:layout_constraintTop_toBottomOf="@+id/tvNamaUser"
                            app:layout_constraintEnd_toStartOf="@+id/layoutKananHeader" />

                        <!-- Area Kanan Header: Notifikasi + Pusat Bantuan -->
                        <LinearLayout
                            android:id="@+id/layoutKananHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <FrameLayout
                                android:id="@+id/frameNotif"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="6dp">

                                <ImageView
                                    android:id="@+id/ivNotifikasi"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_notifikasi"
                                    android:background="@drawable/ic_bg_notif"
                                    android:padding="8dp"
                                    android:scaleType="centerInside" />

                                <TextView
                                    android:id="@+id/tvBadgeNotif"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:text="0"
                                    android:textSize="8sp"
                                    android:textColor="@color/white"
                                    android:fontFamily="@font/poppins_bold"
                                    android:gravity="center"
                                    android:background="@color/red_gagal"
                                    android:visibility="gone"
                                    android:layout_gravity="top|end" />
                            </FrameLayout>

                            <!-- Tombol Pusat Bantuan -->
                            <LinearLayout
                                android:id="@+id/btnPusatBantuan"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/ic_bg_notif"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="10dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@android:drawable/ic_menu_help"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Bantuan"
                                    android:textColor="@color/white"
                                    android:textSize="10sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </RelativeLayout>

            <!-- CARD SALDO & MENU AKSI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Inner Card Oranye -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/orange_primary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvMulaiMenyetor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/poppins_bold"
                                    android:text="Mulai Menabung"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <!-- Tombol Mata Sembunyikan Saldo -->
                                <ImageView
                                    android:id="@+id/btnToggleHideSaldo"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:src="@android:drawable/ic_menu_view"
                                    app:tint="@color/white" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardSaldoTabungan"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/white">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Saldo Tabungan"
                                            android:textColor="@color/gray_text"
                                            android:textSize="11sp"
                                            android:fontFamily="@font/poppins_regular" />

                                        <TextView
                                            android:id="@+id/tvSaldoTabungan"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Rp 0"
                                            android:textColor="@color/orange_primary"
                                            android:textSize="15sp"
                                            android:textStyle="bold"
                                            android:fontFamily="@font/poppins_bold"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardSaldoBonus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/white">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Saldo Bonus"
                                            android:textColor="@color/gray_text"
                                            android:textSize="11sp"
                                            android:fontFamily="@font/poppins_regular" />

                                        <TextView
                                            android:id="@+id/tvSaldoBonus"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Rp 0"
                                            android:textColor="@color/orange_primary"
                                            android:textSize="15sp"
                                            android:textStyle="bold"
                                            android:fontFamily="@font/poppins_bold"
                                            android:layout_marginTop="4dp" />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- MENU AKSI -->
                    <LinearLayout
                        android:id="@+id/layoutMenuAksi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:paddingBottom="4dp">

                        <LinearLayout android:id="@+id/btnCariUB"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_lokasi"
                                android:background="@drawable/ic_bg_menu_aksi_orange"
                                app:tint="@color/orange_primary"
                                android:padding="11dp" android:scaleType="centerInside" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Lokasi\nUB" android:textColor="@color/black"
                                android:textSize="10sp" android:gravity="center"
                                android:fontFamily="@font/poppins_semibold" android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/btnReward"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_nav_reward"
                                android:background="@drawable/ic_bg_menu_aksi_orange"
                                app:tint="@color/orange_primary"
                                android:padding="11dp" android:scaleType="centerInside" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reward" android:textColor="@color/black"
                                android:textSize="10sp" android:gravity="center"
                                android:fontFamily="@font/poppins_semibold" android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/btnRiwayat"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_riwayat"
                                android:background="@drawable/ic_bg_menu_aksi_orange"
                                app:tint="@color/orange_primary"
                                android:padding="11dp" android:scaleType="centerInside" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Riwayat" android:textColor="@color/black"
                                android:textSize="10sp" android:gravity="center"
                                android:fontFamily="@font/poppins_semibold" android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/btnRequestPenarikan"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_request"
                                android:background="@drawable/ic_bg_menu_aksi_orange"
                                app:tint="@color/orange_primary"
                                android:padding="11dp" android:scaleType="centerInside" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Request\nPenarikan" android:textColor="@color/black"
                                android:textSize="10sp" android:gravity="center"
                                android:fontFamily="@font/poppins_semibold" android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD TOTAL POIN & REWARD TERSEDIA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView android:id="@+id/ivKoin"
                        android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_poin_reward"
                        app:layout_constraintBottom_toBottomOf="@+id/tvTotalPoinLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />
                    <TextView android:id="@+id/tvTotalPoinLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Poin" android:textSize="11sp"
                        android:textColor="@color/gray_text" android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@+id/ivKoin"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView android:id="@+id/tvTotalPoin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/black" android:fontFamily="@font/poppins_bold"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@+id/ivKoin"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalPoinLabel" />
                    <TextView android:id="@+id/tvRewardTersediaLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Reward Tersedia" android:textSize="11sp"
                        android:textColor="@color/gray_text" android:fontFamily="@font/poppins_regular"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView android:id="@+id/tvRewardTersedia"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/black" android:fontFamily="@font/poppins_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvRewardTersediaLabel" />
                    <View android:id="@+id/divider"
                        android:layout_width="0dp" android:layout_height="1dp"
                        android:background="@color/gray_border" android:layout_marginTop="12dp"
                        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalPoin" />
                    <ImageView android:id="@+id/ivHadiah"
                        android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_nav_reward" android:layout_marginTop="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider" />
                    <TextView android:id="@+id/tvInfoReward"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:text="Ada reward yang bisa kamu tukar!"
                        android:textSize="12sp" android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="8dp" android:layout_marginTop="10dp"
                        app:layout_constraintStart_toEndOf="@+id/ivHadiah"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD SETORAN MINYAK & LEVEL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <TextView android:id="@+id/tvSaldoMinyakLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Setoran" android:textSize="12sp"
                        android:textColor="@color/gray_text" android:fontFamily="@font/poppins_regular"
                        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                    <TextView android:id="@+id/tvLevelLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Level Nasabah" android:textSize="12sp"
                        android:textColor="@color/gray_text" android:fontFamily="@font/poppins_regular"
                        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
                    <TextView android:id="@+id/tvSaldoMinyak"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 Kg" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/black" android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSaldoMinyakLabel" />
                    <ImageView android:id="@+id/ivBintang"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_bintang" android:layout_marginTop="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvLevelLabel" />
                    <ProgressBar android:id="@+id/progressMinyak"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="8dp"
                        android:layout_marginTop="12dp" android:progress="0"
                        android:progressTint="@color/orange_primary"
                        android:progressBackgroundTint="@color/gray_border"
                        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSaldoMinyak" />
                    <TextView android:id="@+id/tvProgressLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mulai setor untuk kumpulkan poin!"
                        android:textSize="11sp" android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" android:layout_marginTop="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/progressMinyak" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- PREVIEW UNIT BISNIS TERDEKAT -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/orange_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unit Bisnis Terdekat"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold" />
                        <TextView
                            android:id="@+id/tvLihatSemuaUB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihat Semua →"
                            android:textSize="11sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            android:alpha="0.85"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvUnitBisnisPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD AJAKAN MITRA UNIT BISNIS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAjakUnitBisnis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_bg_tab_inactive"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_nav_setor" />

                        <TextView
                            android:layout_width="wrap_content"
