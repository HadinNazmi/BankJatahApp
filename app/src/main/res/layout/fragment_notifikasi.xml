<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Notifikasi"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintEnd_toStartOf="@+id/btnTandaiSemua"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btnTandaiSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tandai Dibaca"
            android:textSize="12sp"
            android:textColor="@color/orange_primary"
            android:fontFamily="@font/poppins_regular"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB FILTER WAKTU -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSemua"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Semua"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/ic_bg_tab_active" />

            <TextView
                android:id="@+id/tabHariIni"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Hari Ini"
                android:textSize="12sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <TextView
                android:id="@+id/tabMingguIni"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Minggu Ini"
                android:textSize="12sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

            <TextView
                android:id="@+id/tabBulanIni"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Bulan Ini"
                android:textSize="12sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_bg_tab_inactive" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- INFO JUMLAH BELUM DIBACA -->
    <TextView
        android:id="@+id/tvBelumDibaca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/orange_primary"
        android:fontFamily="@font/poppins_regular"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp" />

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:indeterminateTint="@color/orange_primary"
        android:visibility="gone" />

    <!-- KOSONG -->
    <TextView
        android:id="@+id/tvKosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tidak ada notifikasi"
        android:textSize="14sp"
        android:textColor="@color/gray_text"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginTop="60dp"
        android:visibility="gone" />

    <!-- LIST NOTIFIKASI -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifikasi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>