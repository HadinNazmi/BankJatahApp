<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.auth.RegisterActivity">

    <!-- Tombol Back di pojok kiri atas -->
    <ImageView
        android:id="@+id/btnBackToLogin"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_back"
        android:scaleType="centerInside"
        android:background="@drawable/ic_bg_notif"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/btnBackToLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Card utama -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRegister"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp">

                    <!-- Logo -->
                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/bankjatahlogo"
                        android:scaleType="centerInside"
                        android:padding="12dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvJudul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daftar Akun Baru"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/imgLogo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Mulai menabung minyak jelantah dan dapatkan reward!"
                        android:textSize="13sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvJudul"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Nama Lengkap -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNama"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nama lengkap"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPersonName"
                            android:drawableEnd="@drawable/ic_person"
                            android:drawablePadding="8dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/tilNama"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textEmailAddress"
                            android:drawableEnd="@drawable/ic_email"
                            android:drawablePadding="8dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nomor Telepon — TANPA prefixText +62 agar tidak ambigu -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNoTelp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/tilEmail"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNoTelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contoh: 082283884373"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="phone"
                            android:maxLength="15" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:layout_constraintTop_toBottomOf="@+id/tilNoTelp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Buat password"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Konfirmasi Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilKonfirmasiPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:layout_constraintTop_toBottomOf="@+id/tilPassword"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKonfirmasiPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Konfirmasi password"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- NIK -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNik"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/tilKonfirmasiPassword"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNik"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="NIK (16 digit)"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="number"
                            android:maxLength="16" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Kode Referral (Opsional) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilReferal"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:helperText="Opsional"
                        app:helperTextTextColor="@color/gray_text"
                        app:layout_constraintTop_toBottomOf="@+id/tilNik"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Kode referal"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Checkbox Syarat & Ketentuan -->
                    <LinearLayout
                        android:id="@+id/layoutSyarat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tilReferal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <CheckBox
                            android:id="@+id/cbSyarat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/orange_primary" />

                        <TextView
                            android:id="@+id/tvSetujuSyarat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Saya setuju dengan "
                            android:textSize="12sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvLinkSyarat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Syarat &amp; Ketentuan"
                            android:textSize="12sp"
                            android:textColor="@color/orange_primary"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ProgressBar loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/orange_primary"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/cardRegister"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tombol Daftar -->
            <Button
                android:id="@+id/btnDaftar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:text="Daftar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:backgroundTint="@color/orange_primary"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@+id/cardRegister"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Sudah punya akun? -->
            <TextView
                android:id="@+id/tvSudahPunyaAkun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sudah punya akun? "
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_regular"
                app:layout_constraintTop_toBottomOf="@+id/btnDaftar"
                app:layout_constraintEnd_toStartOf="@+id/tvMasuk"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <TextView
                android:id="@+id/tvMasuk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masuk"
                android:textSize="13sp"
                android:textColor="@color/orange_primary"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toTopOf="@+id/tvSudahPunyaAkun"
                app:layout_constraintBottom_toBottomOf="@+id/tvSudahPunyaAkun"
                app:layout_constraintStart_toEndOf="@+id/tvSudahPunyaAkun"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>