<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="4dp">

    <!-- Card G1 utama -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Baris utama: avatar + info + setoran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_bg_menu_aksi_orange"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvInisialG1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold" />

                </LinearLayout>

                <!-- Nama + info level -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvNamaG1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Nasabah"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_semibold" />

                        <!-- Badge G1 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" G1"
                            android:textSize="10sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInfoG1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="B1 • Pasif"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <!-- Total setoran -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Setoran"
                        android:textSize="9sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/tvSetoranG1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Kg"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- Tombol expand -->
            <TextView
                android:id="@+id/tvExpandBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Lihat downline"
                android:textSize="10sp"
                android:textColor="@color/orange_primary"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="6dp"
                android:paddingStart="50dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Container G2 -->
    <LinearLayout
        android:id="@+id/containerG2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:visibility="gone" />

</LinearLayout>