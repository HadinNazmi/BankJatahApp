<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/orange_primary"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_back"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Akun"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/orange_primary">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ImageView
                        android:id="@+id/ivFotoProfil"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="@drawable/ic_bg_foto_profil"
                        android:padding="16dp"
                        android:scaleType="centerCrop" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnGantiFoto"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/white"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_camera"
                            android:padding="4dp"
                            android:scaleType="centerInside" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ketuk ikon kamera untuk ganti foto"
                    android:textSize="11sp"
                    android:textColor="#CCFFFFFF"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFIL PERSONAL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/itemEditNama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nama Lengkap"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvNamaValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/itemEditNoTelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nomor Telepon"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvNoTelpValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/itemEditAlamat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alamat Rumah"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvAlamatValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/itemGantiPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Password"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="••••••••"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REKENING PENCAIRAN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/itemEditBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nama Bank Tujuan"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvBankValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/itemEditNoRekening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nomor Rekening"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvNoRekeningValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/itemEditAtasNama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Atas Nama Pemilik Rekening"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvAtasNamaValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah →"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMASI SISTEM"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email Terdaftar"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvEmailValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kunci"
                            android:textSize="10sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NIK (Nomor Induk Kependudukan)"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvNikValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kunci"
                            android:textSize="10sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kode Referral Anda"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvKodeReferralValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/orange_primary"
                                android:fontFamily="@font/poppins_bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvBagikanKeTeman"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salin Kode"
                            android:textSize="11sp"
                            android:textColor="@color/orange_primary"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Level"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvLevelBintangValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kategori"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvKategoriValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status Akun"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text"
                                android:fontFamily="@font/poppins_regular" />
                            <TextView
                                android:id="@+id/tvStatusAkunValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
