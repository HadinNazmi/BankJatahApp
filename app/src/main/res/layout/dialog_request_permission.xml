<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@android:drawable/ic_menu_mylocation"
        android:background="@drawable/ic_bg_aktivitas_orange"
        android:padding="12dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Izin Akses Diperlukan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_bold"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplikasi memerlukan izin Lokasi dan Notifikasi agar Anda dapat menemukan Unit Bisnis terdekat dan menerima update transaksi."
        android:textSize="13sp"
        android:textColor="@color/gray_text"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnIzinkanPopUp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Izinkan Sekarang"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_semibold"
        android:backgroundTint="@color/orange_primary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnNantiSaja"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Nanti Saja"
        android:textSize="12sp"
        android:textColor="@color/gray_text"
        android:fontFamily="@font/poppins_regular"
        android:backgroundTint="@android:color/transparent"
        app:cornerRadius="12dp" />

</LinearLayout>