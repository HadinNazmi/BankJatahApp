<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== HEADER ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setor Minyak"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== CARD PROGRESS TARGET BULANAN ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTargetLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Total Setoran Bulan Ini"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvTotalSetoran"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTotalSetoran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0L"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange_primary"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/progressTarget"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:progress="0"
                    android:progressTint="@color/orange_primary"
                    android:progressBackgroundTint="@color/gray_border"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTargetLabel" />

                <ImageView
                    android:id="@+id/ivDroplet"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_setor"
                    android:layout_marginTop="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/progressTarget" />

                <TextView
                    android:id="@+id/tvSisaTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivDroplet"
                    app:layout_constraintTop_toBottomOf="@+id/progressTarget" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== FORM INPUT ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== IDENTITAS NASABAH ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identitas Nasabah"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

                <!-- ===== AREA QR SCANNER PROFESIONAL ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/black">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="260dp">

                        <!-- Live camera preview CameraX -->
                        <androidx.camera.view.PreviewView
                            android:id="@+id/cameraPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <!-- Custom overlay bingkai oranye -->
                        <com.example.bankjatahapp.ui.component.QrScannerOverlayView
                            android:id="@+id/qrOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <!-- Placeholder sebelum scan dibuka (tap untuk buka kamera) -->
                        <LinearLayout
                            android:id="@+id/frameQrScanner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@color/black"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <!-- Bingkai QR dekoratif oranye -->
                            <FrameLayout
                                android:layout_width="160dp"
                                android:layout_height="160dp">

                                <!-- Sudut kiri atas — horizontal -->
                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="4dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="top|start" />
                                <!-- Sudut kiri atas — vertikal -->
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="40dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="top|start" />

                                <!-- Sudut kanan atas — horizontal -->
                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="4dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="top|end" />
                                <!-- Sudut kanan atas — vertikal -->
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="40dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="top|end" />

                                <!-- Sudut kiri bawah — horizontal -->
                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="4dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="bottom|start" />
                                <!-- Sudut kiri bawah — vertikal -->
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="40dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="bottom|start" />

                                <!-- Sudut kanan bawah — horizontal -->
                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="4dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="bottom|end" />
                                <!-- Sudut kanan bawah — vertikal -->
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="40dp"
                                    android:background="@color/orange_primary"
                                    android:layout_gravity="bottom|end" />

                                <!-- Icon kamera di tengah bingkai -->
                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    app:tint="#80FFFFFF"
                                    android:layout_gravity="center" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap untuk Scan QR Nasabah"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginTop="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Arahkan kamera ke QR identitas nasabah"
                                android:textSize="12sp"
                                android:textColor="#80FFFFFF"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Label instruksi saat scan aktif -->
                        <TextView
                            android:id="@+id/tvScanInstruksi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Arahkan QR ke dalam bingkai"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:background="#88000000"
                            android:padding="8dp"
                            android:layout_gravity="bottom"
                            android:visibility="gone" />

                        <!-- Tombol tutup kamera (X) -->
                        <ImageView
                            android:id="@+id/btnTutupKamera"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:background="#88000000"
                            android:padding="8dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:visibility="gone" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Divider atau -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/gray_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  atau masukkan ID manual  "
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/gray_border" />

                </LinearLayout>

                <!-- Input manual ID + tombol Cek -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilIdNasabah"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/gray_border"
                        app:hintEnabled="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnCekNasabah"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIdNasabah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Masukkan 8 digit ID..."
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/black"
                            android:inputType="text"
                            android:maxLength="8" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnCekNasabah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cek"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/black"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Info nama nasabah setelah cek/scan -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutInfoNasabah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#F0FFF4"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivCeklis"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/checkbox_on_background"
                        android:scaleType="centerInside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvNamaNasabah"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nama Nasabah"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/ivCeklis"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvIdNasabahInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="ID: -"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/ivCeklis"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvNamaNasabah" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ===== BERAT BERSIH ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berat Bersih Minyak"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilJumlah"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Masukkan berat minyak"
                    app:suffixText="Kg"
                    app:suffixTextColor="@color/gray_text"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/gray_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etJumlah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="14sp"
                        android:textColor="@color/black" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Kalkulasi otomatis -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutKalkulasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF8F0"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimasi diterima nasabah:"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvEstimasiRupiah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_border"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- ===== FOTO BUKTI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto Bukti Setoran (Opsional)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

                <FrameLayout
                    android:id="@+id/layoutUploadArea"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ic_bg_upload_area">

                    <ImageView
                        android:id="@+id/ivPreviewFoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutPlaceholderFoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:alpha="0.3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto tidak wajib saat ini"
                            android:textSize="12sp"
                            android:textColor="@color/gray_text"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="6dp" />

                        <Button
                            android:id="@+id/btnBukaKamera"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Ambil Foto"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/gray_text"
                            android:layout_marginTop="8dp"
                            app:cornerRadius="20dp" />

                    </LinearLayout>
                </FrameLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_border"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- ===== CATATAN ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan (Opsional)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCatatan"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/gray_border"
                    app:hintEnabled="false"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCatatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tambahkan catatan..."
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/black"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:maxLines="4"
                        android:gravity="top"
                        android:maxLength="200" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== TOMBOL KONFIRMASI ===== -->
        <Button
            android:id="@+id/btnKonfirmasi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Konfirmasi Setor"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_semibold"
            android:backgroundTint="@color/orange_primary"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pastikan ID nasabah dan berat sudah benar sebelum konfirmasi"
            android:textSize="11sp"
            android:textColor="@color/gray_text"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp" />

        <!-- ===== CARD RINGKASAN ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_bold" />

                <!-- Total Rupiah Nasabah -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:id="@+id/ivIconWallet"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_request"
                        android:background="@drawable/ic_bg_aktivitas_orange"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvSaldoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Total Rupiah Nasabah"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconWallet"
                        app:layout_constraintEnd_toStartOf="@+id/tvSaldoNilai"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvSaldoSubLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Akan didapat nasabah"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconWallet"
                        app:layout_constraintEnd_toStartOf="@+id/tvSaldoNilai"
                        app:layout_constraintTop_toBottomOf="@+id/tvSaldoLabel" />

                    <TextView
                        android:id="@+id/tvSaldoNilai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_border"
                    android:layout_marginTop="12dp" />

                <!-- Harga per Kg -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:id="@+id/ivIconPoin"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bintang"
                        android:background="@drawable/ic_bg_aktivitas_orange"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvPoinLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Harga per Kg"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconPoin"
                        app:layout_constraintEnd_toStartOf="@+id/tvPoinNilai"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPoinSubLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Harga sementara"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconPoin"
                        app:layout_constraintEnd_toStartOf="@+id/tvPoinNilai"
                        app:layout_constraintTop_toBottomOf="@+id/tvPoinLabel" />

                    <TextView
                        android:id="@+id/tvPoinNilai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 90/Kg"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_primary"
                        android:fontFamily="@font/poppins_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_border"
                    android:layout_marginTop="12dp" />

                <!-- Estimasi Validasi -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:id="@+id/ivIconValidasi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_riwayat"
                        android:background="@drawable/ic_bg_aktivitas_orange"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvValidasiLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Estimasi Validasi"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconValidasi"
                        app:layout_constraintEnd_toStartOf="@+id/tvValidasiNilai"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvValidasiSubLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Waktu proses"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconValidasi"
                        app:layout_constraintEnd_toStartOf="@+id/tvValidasiNilai"
                        app:layout_constraintTop_toBottomOf="@+id/tvValidasiLabel" />

                    <TextView
                        android:id="@+id/tvValidasiNilai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1-2 Jam"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>